{
  "name": "kindlink-backend",
  "version": "1.0.0",
  "description": "Backend API for KindLink application",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:spec": "node --test --test-reporter=spec",
    "test:auth": "node --test --experimental-test-coverage test/auth-and-authorization.test.js",
    "test:profile": "node --test --experimental-test-coverage test/profile-management.test.js",
    "test:reviews": "node --test --experimental-test-coverage test/rating-feedback.test.js",
    "test:core": "node --test --experimental-test-coverage test/auth-and-authorization.test.js test/profile-management.test.js test/rating-feedback.test.js",
    "test:existing": "node --test --experimental-test-coverage test/appointment-assignment.test.js test/approval.test.js test/chat-access.test.js test/email-from.test.js test/id-document.test.js test/notification-targeting.test.js test/profile-photo.test.js test/safety-pin-verification.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.0",
    "resend": "^6.26.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
