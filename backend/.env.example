PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret

# --- Profile pictures (Supabase required for new uploads) -----------------
# Existing local photos remain readable. Missing configuration returns a clear
# upload error; new pictures never silently fall back to local server storage.
#
# Create a PUBLIC bucket named avatars. Set its maximum file size to 5 MB and
# allow image/jpeg (the backend validates and re-encodes all accepted images).
# Keep anonymous/authenticated storage write policies disabled: only this backend
# writes files. The app uses KindLink JWT authentication, not Supabase Auth.
#
# Never put secret keys in mobile environment variables or commit them.
# SUPABASE_SERVICE_ROLE_KEY is also supported for existing installations.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_AVATAR_BUCKET=avatars
