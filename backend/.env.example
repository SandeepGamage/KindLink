PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret

# --- Avatar storage (optional) -------------------------------------------
# Leave these blank to store uploaded profile pictures on the server's own
# disk (backend/uploads/avatars). Fill them in to store them in Supabase
# Storage instead — the backend picks the driver automatically at startup and
# logs which one is active.
#
# Setup:
#  1. supabase.com -> new project.
#  2. Storage -> New bucket named "avatars", with PUBLIC BUCKET turned ON.
#  3. SUPABASE_URL: the "Connect" button at the top of the dashboard, or read it
#     off the address bar (.../project/<ref> -> https://<ref>.supabase.co).
#  4. SUPABASE_SECRET_KEY: Settings -> API Keys. If the project only shows a
#     publishable key, use "Create new secret key" — it is not created for you.
#
# Use the SECRET key (sb_secret_...), NOT the publishable one: the publishable
# key is the client-safe key and cannot write to storage. The secret key must
# never appear in the mobile or admin app, or in a commit.
#
# SUPABASE_SERVICE_ROLE_KEY is the older name for the same thing and is still
# read as a fallback; Supabase deprecates those legacy keys at the end of 2026.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_AVATAR_BUCKET=avatars
