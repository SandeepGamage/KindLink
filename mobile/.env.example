# KindLink Mobile — Environment Variables Example
# Copy this file to .env and fill in your values

# Backend API base URL
# Leave empty in development: the app reuses the host Metro is served from
# (your PC's current LAN IP on a physical device, 10.0.2.2 on the Android
# emulator, localhost on the iOS simulator / web), so switching Wi-Fi networks
# needs no edit. Do NOT hard-code your LAN IP here — it goes stale when the
# network changes.
#
# Set it only for a deployed backend, a backend on another machine, tunnel
# mode (expo start --tunnel), or EAS / store builds (no Metro host there):
#   EXPO_PUBLIC_API_URL=https://api.example.com/api
EXPO_PUBLIC_API_URL=

# Backend port used by the dev fallback above (defaults to 5000)
# EXPO_PUBLIC_PORT=5000
